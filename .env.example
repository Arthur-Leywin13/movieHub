# === MoviesHub — variables d'environnement ===
# Copier en .env (jamais commité). Aucune valeur secrète ici.

NODE_ENV=development

# --- Base de données (API + packages/database uniquement) ---
DATABASE_URL=postgresql://movieshub:CHANGE_ME@localhost:5432/movieshub?schema=public

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# true uniquement derrière un reverse proxy de confiance (lit l'IP dans X-Forwarded-For)
API_TRUST_PROXY=false
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules (sans slash final)
API_CORS_ORIGINS=
# Secrets >= 32 caractères, tous différents (générer: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# JWT_ACCESS_SECRET signe les jetons d'accès ; JWT_REFRESH_SECRET sert de clé HMAC pour hacher les refresh tokens en base.
# Changer l'un d'eux déconnecte tous les utilisateurs.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Jeton de service partagé avec le bot (le bot appelle l'API, jamais la base)
BOT_SERVICE_TOKEN=

# Premier administrateur : créé au démarrage de l'API SEULEMENT s'il n'existe encore aucun administrateur.
# Les trois variables ensemble ; mot de passe >= 12 caractères ; l'identifiant Telegram est numérique.
# Une fois l'administrateur créé, vous pouvez retirer ces trois lignes.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# --- Cloudflare R2 (API uniquement, jamais dans un client) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL_SECONDS=900

# --- Bot Telegram (apps/bot uniquement) ---
TELEGRAM_BOT_TOKEN=
API_BASE_URL=http://localhost:3000
# Serveur Bot API local (docker compose --profile bot). Obligatoire pour les fichiers > 20 Mo.
# Avec le serveur officiel (https://api.telegram.org), BOT_MAX_FILE_BYTES doit être <= 20971520.
TELEGRAM_API_BASE_URL=http://localhost:8081
# Limite par fichier : 2000 Mo (maximum Telegram)
BOT_MAX_FILE_BYTES=2097152000
# Dossier des conversations en cours du bot (doit survivre aux redémarrages)
BOT_STATE_DIR=./data/bot
# Identifiants de l'application Telegram (my.telegram.org), lus par docker compose pour le serveur local uniquement
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Ids Telegram numériques autorisés, séparés par des virgules (pas les @username)
TELEGRAM_ADMIN_IDS=
